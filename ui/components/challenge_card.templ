package components

import "strconv"

templ ChallengeCard(c models.Challenge) {
	<div class="challenge-detail">
		<h1>{ c.Title }</h1>
		<p>{ c.Description }</p>
		<form>
			<label>
				<input type="text" name="flag" placeholder="Enter flag" required/>
			</label>
			<button type="submit" hx-post={ "/challenges/" + strconv.Itoa(int(c.ID)) + "/submit" } hx-target="main">Submit</button>
		</form>
	</div>
}
