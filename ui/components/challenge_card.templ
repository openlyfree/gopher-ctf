package components

import (
	"github.com/openlyfree/gopher-ctf/internal/models"
	"strconv"
)

templ ChallengeCard(c models.Challenge, completed bool) {
	<div class="challenge-detail">
		<a class="challenge-filter" href="/challenges" hx-get="/challenges" hx-target="main" hx-replace-url="true">Back to challenges</a>
		<h1>{ c.Title }</h1>
		<div class="challenge-content">
            <div class="challenge-description"><p>{ c.Description }</p></div>
        if len(c.HintList()) > 0 {
            <section class="challenge-hints" aria-label="Free hints">
                <h3>need a hint?</h3>
                <p>hints are free. your points stay the same :D</p>
                for i, hint := range c.HintList() {
                    <details class="challenge-hint">
                        <summary>hint { strconv.Itoa(i+1) } (free)</summary>
                        <p>{ hint }</p>
                    </details>
                }
            </section>
        }
        </div>
		<div id="challenge-status">
            if completed {
                <p class="challenge-completed">completed! 🔥</p>
            }
        </div>
        if !completed {
        <form id="flag-form" class="panel__form">
			<label class="panel__field">
				<span>flag</span>
				<input type="text" name="flag" placeholder="flag{...}" required/>
			</label>
			<button type="submit" hx-post={ "/challenges/" + strconv.Itoa(int(c.ID)) + "/submit" } hx-target="#flag-result">Submit</button>
		</form>
        }
        <div id="flag-result" class="panel__result" role="status" aria-live="polite"></div>
	</div>
}


templ CompletionFeedback(message string) {
 <span>{ message }</span>
 <div id="challenge-status" hx-swap-oob="outerHTML">
  <p class="challenge-completed">completed! 🔥</p>
 </div>
 <div id="flag-form" hx-swap-oob="outerHTML"></div>
}
