package pages

import "gopher-ctf/ui/components"

templ Admin() {
	@components.Layout("Admin Dashboard") {
		<p>uhh if ur not supposed to be here please leave, thank you</p> <!-- final and strongest defense -->
		<p>upload challenges: </p>
		<form hx-post="/admin/challenge"
			hx-target="#upload-result"
			enctype="multipart/form-data">
			<input type="file" accept="application/json"/>
			<button type="submit">Submit</button>
		</form>
	}
}
