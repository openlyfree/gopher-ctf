package pages

import (
	"github.com/openlyfree/gopher-ctf/internal/models"
	"github.com/openlyfree/gopher-ctf/ui/components"
	"strconv"
)

templ Challenges(challenges []models.Challenge) {
	<div class="challenges-container">
		<h1>Challenges</h1>
		<div class="challenges-grid">
			for _, c := range challenges {
				<div class="challenge-card">
					<h2>{ c.Title }</h2>
					<p>{ c.Description }</p>
					<button hx-get={ "/challenges/" + strconv.Itoa(int(c.ID)) } hx-target="main">View Challenge</button>
				</div>
			}
		</div>
	</div>
}

templ ChallengesPage(challenges []models.Challenge) {
	@components.Layout("Challenges") {
		@Challenges(challenges)
	}
}
