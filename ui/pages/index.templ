package pages

import (
	"context"
	"github.com/openlyfree/gopher-ctf/ui/components"
)

func GetUser(ctx context.Context) string {
	if val := ctx.Value("username"); val != nil {
		return val.(string)
	}
	return ""
}

templ Index() {
	@components.Layout("Gopher CTF") {
		if GetUser(ctx) == "" {
			<h1>Welcome to Gopher CTF!</h1>
			<p>The fast, Go-powered CTF platform.</p>
			<button hx-get="/register" hx-target="main" hx-replace-url="true" >Join the CTF</button>
		} else {
			<h1>Welcome back, { GetUser(ctx) }!</h1>
		}
	}
}
