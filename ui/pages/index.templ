package pages

import (
	"context"
	"gopher-ctf/ui/components"
)

func GetUser(ctx context.Context) string {
	if val := ctx.Value("username"); val != nil {
		return val.(string)
	}
	return ""
}

func getWelcome() string {
	usr := GetUser(context.Background())
	if usr == "" {
		return "Welcome to Gopher CTF!"
	}
	return "Welcome to Gopher CTF, " + usr + "!"
}

templ Index() {
	@components.Layout("Home") {
		<main class="hero">
			<h1>{ getWelcome() }</h1>
			<p>The fast, Go-powered CTF platform.</p>
			if GetUser(ctx) == "" {
                <button hx-get="/register" hx-target="main">Join the CTF</button>
            }
		</main>
	}
}
