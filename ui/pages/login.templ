package pages

import "github.com/openlyfree/gopher-ctf/ui/components"

templ Login() {
	<div class="login">
		<h2>Log in</h2>
		<form class="panel__form" hx-post="/login" hx-target="#error-msg">
			<label class="panel__field">
				<span>username</span>
				<input type="text" name="username" placeholder="Username" required/>
			</label>
			<label class="panel__field">
				<span>password</span>
				<input type="password" name="password" placeholder="Password" required/>
			</label>
			<button type="submit">Log in</button>
		</form>
		<div id="error-msg" class="panel__result"></div>
	</div>
}

templ LoginPage() {
	@components.Layout("Log in") {
		@Login()
	}
}
