package pages

import (
	"github.com/openlyfree/gopher-ctf/internal/models"
	"github.com/openlyfree/gopher-ctf/ui/components"
	"strconv"
)

templ Scoreboard(users []models.User) {
	<div class="scoreboard-container" hx-get="/scoreboard" hx-trigger="every 10s" hx-swap="outerHTML">
		<div class="scoreboard-table-wrapper">
			<table class="scoreboard-table">
				<thead>
					<tr>
						<th class="rank-col">Rank</th>
						<th class="user-col">Player</th>
						<th class="score-col">Score</th>
					</tr>
				</thead>
				<tbody>
					for i, u := range users {
						<tr class="scoreboard-row" data-rank={ strconv.Itoa(i + 1) }>
							<td class="rank-cell">
								<span class="rank-badge">{ strconv.Itoa(i+1) }</span>
							</td>
							<td class="user-cell">{ u.Username }</td>
							<td class="score-cell">{ strconv.Itoa(u.Score) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ScoreboardPage(users []models.User) {
	@components.Layout("Scoreboard") {
		@Scoreboard(users)
	}
}
