package pages

import "github.com/openlyfree/gopher-ctf/ui/components"

templ Signup() {
	<div class="signup">
		<h2>Sign up</h2>
		<form class="panel__form" hx-post="/register" hx-target="#error-msg">
			<label class="panel__field">
				<span>username</span>
				<input type="text" name="username" placeholder="Username" required/>
			</label>
			<label class="panel__field">
				<span>password</span>
				<input type="password" name="password" placeholder="Password" required/>
			</label>
			<button type="submit">Sign up</button>
		</form>
		<div id="error-msg" class="panel__result"></div>
	</div>
}

templ SignupPage() {
	@components.Layout("Join") {
		@Signup()
	}
}
